/* Button input and debounce */
#define BUTTON_COUNT 3u
#define BUTTON_HISTORY_MASK 0x07u

static const uint16_t button_pins[BUTTON_COUNT] = {
    GPIO_PIN_8,
    GPIO_PIN_9,
    GPIO_PIN_10
};

static uint8_t history[BUTTON_COUNT] = {0x07u, 0x07u, 0x07u};
static uint8_t released_state[BUTTON_COUNT] = {1u, 1u, 1u};
static volatile uint8_t pressed_events[BUTTON_COUNT] = {0u, 0u, 0u};

void Button_Init(void)
{
    for (uint8_t i = 0; i < BUTTON_COUNT; ++i) {
        history[i] = BUTTON_HISTORY_MASK;
        released_state[i] = 1u;
        pressed_events[i] = 0u;
    }
}

void Button_ScanTick(void)
{
    for (uint8_t i = 0; i < BUTTON_COUNT; ++i) {
        uint8_t sample = (HAL_GPIO_ReadPin(GPIOB, button_pins[i]) == GPIO_PIN_SET) ? 1u : 0u;
        history[i] = (uint8_t)(((history[i] << 1) | sample) & BUTTON_HISTORY_MASK);

        if (history[i] == 0u) {
            if (released_state[i] != 0u) {
                released_state[i] = 0u;
                pressed_events[i] = 1u;
            }
        } else if (history[i] == BUTTON_HISTORY_MASK) {
            released_state[i] = 1u;
        }
    }
}

uint8_t Button_GetPressed(uint8_t index)
{
    uint8_t result;

    if (index >= BUTTON_COUNT) {
        return 0u;
    }

    __disable_irq();
    result = pressed_events[index];
    pressed_events[index] = 0u;
    __enable_irq();

    return result;
}

