/* Single-file Lab 3 implementation based on the uploaded PDF schematic.
   Buttons: PB8=BUT1, PB9=BUT2, PB10=BUT3 (active low).
   Traffic lamps: PA5=REDA, PA6=GREENA, PA7=YELLOWA,
                  PA8=REDB, PA9=GREENB, PA10=YELLOWB.
   Seven-segment group 1: PB0..PB6 = a1..g1.
   Seven-segment group 2: PA4=a2, PA11..PA15=b2..f2, PB7=g2.
   Digit enables: PB15=EN0, PB12=EN1, PB13=EN2, PB14=EN3 (active low).
   TIM2 update interrupt: 10 ms. */

TIM_HandleTypeDef htim2;

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM2_Init(void);
void Error_Handler(void);

typedef enum {
    TRAFFIC_RED = 0,
    TRAFFIC_AMBER,
    TRAFFIC_GREEN,
    TRAFFIC_OFF
} TrafficColor;

